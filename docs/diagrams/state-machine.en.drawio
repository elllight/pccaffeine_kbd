ize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="220" height="86" as="geometry"/></mxCell><mxCell id="c9" value="boot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="host connects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="encrypted · n: 0→1&lt;br&gt;timer = full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="time left = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="timer = full, restart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="450"/><mxPoint x="685" y="450"/></Array></mxGeometry></mxCell><mxCell id="c14" value="n: 1→0&lt;br&gt;(last PC left)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;