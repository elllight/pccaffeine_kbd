<mxfile host="drawio"><diagram id="pairing-steps" name="pairing-steps"><mxGraphModel dx="1100" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="300" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="처음 한 번만 하는 블루투스 페어링" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. 전원 연결&lt;/b&gt;&lt;br&gt;USB-C로 PC나 충전기에 연결&lt;br&gt;화면에 BT 0/3 깜빡임" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2. PC 블루투스 설정 열기&lt;/b&gt;&lt;br&gt;Windows: 설정 › Bluetooth 및 장치&lt;br&gt;macOS: 시스템 설정 › Bluetooth" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;3. PCCaffeine 선택&lt;/b&gt;&lt;br&gt;장치 목록에서 PCCaffeine 연결&lt;br&gt;(PIN 입력 없음)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;4. 연결 확인&lt;/b&gt;&lt;br&gt;화면에 BT 1/3 표시&lt;br&gt;카운트다운 시작" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="한 번 페어링하면 이후에는 전원만 넣어도 자동으로 다시 연결됩니다. 다른 PC도 같은 방법으로 최대 3대까지 함께 연결할 수 있습니다." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1000" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
