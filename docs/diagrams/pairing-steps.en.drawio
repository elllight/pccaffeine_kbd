<mxfile host="drawio"><diagram id="pairing-steps" name="pairing-steps"><mxGraphModel dx="1100" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="300" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="One-time Bluetooth pairing" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. Power it&lt;/b&gt;&lt;br&gt;Plug USB-C into a PC or charger&lt;br&gt;BT 0/3 blinks on screen" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2. Open Bluetooth settings&lt;/b&gt;&lt;br&gt;Windows: Settings › Bluetooth &amp;amp; devices&lt;br&gt;macOS: System Settings › Bluetooth" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;3. Pick PCCaffeine&lt;/b&gt;&lt;br&gt;Connect PCCaffeine in the list&lt;br&gt;(no PIN)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;4. Check it&lt;/b&gt;&lt;br&gt;Screen shows BT 1/3&lt;br&gt;Countdown starts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Pair once and it reconnects by itself whenever powered. Other PCs pair the same way, up to 3 at once." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1000" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
